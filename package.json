{
  "name": "review-reply-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Admin panel that drafts Google review replies with OpenAI and posts them to Google Business Profile.",
  "type": "module",
  "main": "src/node.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/node.js",
    "dev": "node --watch src/node.js",
    "create-user": "node scripts/create-user.js",
    "reset-password": "node scripts/create-user.js --reset",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "node scripts/cloudflare/deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
