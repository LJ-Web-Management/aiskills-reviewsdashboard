# ---- Server ----
# Public URL of the dashboard. Must be https:// in production (enables secure cookies + HSTS).
APP_URL=http://localhost:3000
PORT=3000
# NODE_ENV=production
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, nginx, Caddy...).
# TRUST_PROXY=1

# Encrypts the stored Google token and OpenAI key. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If omitted, one is generated into data/secret.key on first start.
APP_SECRET=

# Where the SQLite database lives. Use a persistent disk in production.
# DATA_DIR=./data

# ---- First admin (optional; for hosts where you can't run `npm run create-user`) ----
# Remove both after the first start.
# INITIAL_ADMIN_EMAIL=you@example.com
# INITIAL_ADMIN_PASSWORD=a-long-passphrase-of-12+-chars

# ---- OpenAI ----
# Your key from https://platform.openai.com/api-keys (or paste it in Settings instead).
OPENAI_API_KEY=
# Default model; can be changed in Settings.
OPENAI_MODEL=gpt-5-mini

# ---- Google Business Profile (OAuth "Web application" client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Show sample reviews until a Google location is connected.
DEMO_MODE=true

# Session lifetime
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=24
